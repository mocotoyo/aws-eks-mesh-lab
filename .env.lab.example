# Copiar a .env.lab y editar. No contiene claves ni tokens.
AWS_REGION=us-east-1
EXPECTED_ACCOUNT_ID=REEMPLAZAR_CUENTA_DE_12_DIGITOS
GH_OWNER=mocotoyo
GH_REPO=aws-eks-mesh-lab
GH_VISIBILITY=public
LAB_ID=mocotoyo-mesh-demo
K8S_VERSION=1.35
ISTIO_VERSION=1.32.0
# Referencias de partida, siempre verificar compatibilidad y disponibilidad.
LAB_HOURS=3
SESSION_LIMIT_USD=2
MONTHLY_BUDGET_USD=2
BUDGET_EMAIL=REEMPLAZAR_TU_CORREO
# Tarifas de referencia us-east-1 Linux On-Demand. Revalidar antes de aplicar.
EKS_USD_HOUR=0.10
EC2_USD_HOUR=0.0835
IPV4_USD_HOUR=0.005
GP3_USD_GB_MONTH=0.08
ECR_USD_GB_MONTH=0.10
EXTRA_RESERVE_USD=0.40
CLEANUP_HOURS=0.5
# Por defecto se exige temporizador local systemd antes de crear EKS.
ALLOW_NO_TIMER=false
# Kiali/Prometheus en memoria. No crea PV ni servicios AWS administrados.
ENABLE_KIALI=true
